# Run scripts/setup.ps1 (Windows) or scripts/setup.sh to create .env securely.
# Never commit .env or an encryption key. Keep a separate encrypted backup.

# Native development uses SQLite; Compose overrides this with Postgres.
DATABASE_URL=sqlite:///./data/internpilot.db
DATA_DIR=./data
ENCRYPTION_KEY=

# Generated by setup scripts. Only alphanumeric values are used in DB URLs.
POSTGRES_DB=internpilot
POSTGRES_USER=internpilot
POSTGRES_PASSWORD=
REDIS_PASSWORD=
REDIS_URL=

# Both services bind to loopback on the host. Use a TLS reverse proxy to share.
APP_PORT=3000
API_PORT=8000
INTERNAL_API_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
# Owner-issued, single-use, email-bound invitations. Production requires true.
INVITATION_ONLY=true
# Legacy shared registration token; ignored in invitation-only mode.
REGISTRATION_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WORKER_CONCURRENCY=2
BROWSER_CONCURRENCY=1
WORKER_KINDS=discovery,application,outreach,gmail_sync
CRAWL_BATCH_SIZE=200
CRAWL_LOG_RETENTION_DAYS=14
DISTRIBUTED_RATE_LIMITS=true
TASK_LEASE_SECONDS=180
TEST_MODE=false
TEST_PORTAL_ORIGIN=http://127.0.0.1:8000

# Optional provider; no LLM is required for rules, documents, or discovery.
LLM_PROVIDER=disabled
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_ALLOW_LOCAL=false

# Optional broader local/international search. After adding a key, restart API
# and worker, then enable regional search sources in either explorer.
BRAVE_SEARCH_API_KEY=

# Gmail OAuth web client. Register the exact callback URI with Google.
# Restricted read scopes can require Google verification for public production use.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/outreach/gmail/callback

# No outbound notification delivery is enabled by default. In-app notices work.
# Each external message requires approval in Notifications. Secrets stay server-side.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=


# PostgreSQL connection budget PER API/worker process; include overflow in totals.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800

# Phase 5: shared PostgreSQL admission; SQLite has process-local HTTP limits.
HTTP_GLOBAL_CONCURRENCY=16
HTTP_HOST_CONCURRENCY=2
HTTP_REQUEST_TIMEOUT=30
# Per-host overrides may LOWER concurrency and INCREASE minimum request spacing.
HTTP_HOST_POLICIES={}
QUEUE_MAX_PENDING=10000
QUEUE_OWNER_PENDING=2000
TASK_MAX_ATTEMPTS=3
LLM_DAILY_REQUEST_LIMIT=200
LLM_SCAN_JOB_LIMIT=50
# Shared fixed-window sign-in/owner reauthentication budgets (5 minutes).
# Normalize client IPs only at a trusted reverse proxy; never trust arbitrary XFF.
AUTH_ADDRESS_LIMIT=20
AUTH_GLOBAL_LIMIT=5000
