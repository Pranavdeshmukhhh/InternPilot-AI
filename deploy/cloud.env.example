# Keep this file private after copying to .env.cloud. Never commit real values.
PUBLIC_DOMAIN=internpilot.example.com
CLOUD_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
ENCRYPTION_KEY=
REDIS_PASSWORD=
REGISTRATION_TOKEN=
ALLOW_REGISTRATION=false
INVITATION_ONLY=true
CRAWLER_CONCURRENCY=8
BRAVE_SEARCH_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Publish a real operator support address before accepting public accounts.
PUBLIC_CONTACT_EMAIL=
